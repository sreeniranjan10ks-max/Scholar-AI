# ──────────────────────────────────────────────────────────────────────────────
# Scholar AI — .env.example
#
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit your real .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────


# ─── Flask core ───────────────────────────────────────────────────────────────
# A strong, random secret key for session signing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key

FLASK_ENV=development
DEBUG=false

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,null


# ─── IBM watsonx Orchestrate ──────────────────────────────────────────────────
# Obtain from IBM Cloud → Manage → Access (IAM) → API Keys
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# Obtain from IBM watsonx → Projects → your project → Manage → General
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# Region: us-south | eu-de | eu-gb | jp-tok | au-syd
WATSONX_REGION=us-south

# Full endpoint URL (auto-constructed from WATSONX_REGION if not set)
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model to use — Granite is IBM's flagship family
# See: https://dataplatform.cloud.ibm.com/docs/content/wsj/analyze-data/fm-models.html
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# API version date (YYYY-MM-DD)
WATSONX_API_VERSION=2024-05-31


# ─── IBM IAM ──────────────────────────────────────────────────────────────────
IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token


# ─── Text generation parameters ───────────────────────────────────────────────
MAX_NEW_TOKENS=800
MIN_NEW_TOKENS=20
TEMPERATURE=0.7
TOP_P=0.95
REPETITION_PENALTY=1.1


# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30


# ─── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
